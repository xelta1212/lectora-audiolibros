# ──────────────────────────────────────────────
# .gitignore para Lectora — Creador de Audiolibros
# ──────────────────────────────────────────────

# Entorno virtual de Python
.venv/
venv/
env/
ENV/

# Cachés de Python
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Archivos de distribución / build
dist/
build/
*.egg-info/
.eggs/

# Archivos temporales generados por la app (PDFs cargados, MP3 generados)
*.mp3
*.pdf
*.tmp
tmp/

# Variables de entorno locales (nunca subir claves o secretos)
.env
.env.*
!.env.example

# IDEs y editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Archivos de pytest y cobertura
.pytest_cache/
.coverage
htmlcov/

# MyPy
.mypy_cache/

# Ruff
.ruff_cache/
